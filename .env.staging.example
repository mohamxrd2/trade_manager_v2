# Modèle de configuration STAGING — jamais de secret réel dans ce fichier
# versionné. Copiez-le en .env.staging sur le serveur de staging et
# renseignez les vraies valeurs là-bas uniquement.
#
# Objectif : un environnement qui parle à une VRAIE copie des données (restaurée
# depuis un pg_dump de production), mais qui n'envoie jamais rien à un humain
# réel ni à un service tiers réel pendant les tests.

APP_NAME="Waelly (staging)"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=

# --- Base de données ---
# JAMAIS la base de production. Un garde-fou applicatif (AppServiceProvider::
# guardStagingDatabase()) arrête le process immédiatement si APP_ENV=staging
# et que DB_DATABASE ne vaut pas exactement cette valeur (ou celle de
# STAGING_EXPECTED_DB_DATABASE si vous en changez).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=waelly_staging
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# Personnalisez ici UNIQUEMENT si DB_DATABASE ci-dessus doit être différent
# de "waelly_staging" pour une raison particulière à votre infra.
STAGING_EXPECTED_DB_DATABASE=waelly_staging

# --- E-mails : aucun envoi réel ---
# 'log' écrit les e-mails dans storage/logs/laravel.log au lieu de les
# envoyer — aucun client ne reçoit quoi que ce soit depuis staging.
MAIL_MAILER=log

# --- Notifications push / SMS / webhooks ---
# Au moment de cette préparation, l'application n'a pas encore d'intégration
# push/SMS/webhook (rien dans config/ ni app/Services/ ne les implémente) —
# rien à désactiver aujourd'hui. Si l'une de ces intégrations est ajoutée
# plus tard, son flag d'activation devra être mis à "false"/vide ici AVANT
# toute mise en route de staging avec de vraies données de production.

# --- File d'attente ---
# 'sync' exécute les jobs immédiatement dans la requête HTTP, sans worker à
# lancer séparément — équivalent à "aucun worker tournant en tâche de fond".
QUEUE_CONNECTION=sync

# --- Tâches planifiées (scheduler) ---
# Aucune tâche planifiée n'est définie aujourd'hui (routes/console.php ne
# contient aucun schedule()). Si des tâches planifiées sont ajoutées plus
# tard : NE PAS ajouter l'entrée cron `php artisan schedule:run` sur la
# machine de staging, pour que rien ne s'exécute automatiquement en tâche
# de fond sur les données restaurées.

# --- OAuth Google / Facebook : applications de TEST séparées ---
# Créez des apps OAuth dédiées "staging" dans les consoles Google/Meta
# (jamais les identifiants de production), avec les URLs de redirection
# pointant vers le frontend de staging.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# --- Paiement ---
# Aucune intégration de paiement n'existe encore dans le code à ce jour —
# rien à configurer en mode test pour l'instant. Si un fournisseur de
# paiement est intégré plus tard, ses clés "test"/"sandbox" devront être
# utilisées ici, jamais les clés live.

# --- Frontend / CORS / Sanctum (staging) ---
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true

# --- Seeders : interdits hors local, quoi qu'il arrive ---
# migrate:fresh / db:wipe / db:seed sont bloqués par un garde-fou applicatif
# dès que APP_ENV != local (voir AppServiceProvider::guardDestructiveCommandsOutsideLocal)
# — aucune variable à renseigner ici pour ça, c'est automatique.
