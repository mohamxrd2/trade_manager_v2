<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suite de tests sur PostgreSQL réel (en complément de phpunit.xml, qui
  tourne sur SQLite en mémoire). Cible UNIQUEMENT la base locale dédiée
  "waelly_test" — JAMAIS la base de développement ni waelly_staging.

  Garde-fou applicatif : tests/TestCase.php::setUp() refuse de démarrer tout
  test si DB_DATABASE ne se termine pas par "_test", quelle que soit la
  configuration fournie ici — ce fichier n'est donc pas lui-même la seule
  protection.

  Usage : php artisan test, option "configuration" pointant sur ce fichier.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="waelly_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="DB_PERSISTENT" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
