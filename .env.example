# Modèle de configuration — copiez ce fichier en .env et remplissez les
# valeurs pour VOTRE environnement (local ou production).
#
# Aucune valeur ci-dessous n'est un défaut à garder tel quel : ni secret, ni
# clé, ni URL (locale ou de production) n'est codée en dur dans ce fichier.
# - En développement local : renseignez des valeurs locales (http://localhost...).
# - En production (Render) : ne modifiez jamais ce fichier — définissez les
#   vraies valeurs directement dans les variables d'environnement du service
#   Render (Dashboard → Environment).

APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=

APP_MAINTENANCE_DRIVER=
# APP_MAINTENANCE_STORE=

PHP_CLI_SERVER_WORKERS=

BCRYPT_ROUNDS=

LOG_CHANNEL=
LOG_STACK=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

# --- Base de données (Neon PostgreSQL en production) ---
# Soit DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD séparément,
# soit DB_URL avec la chaîne de connexion complète fournie par Neon
# (postgresql://user:password@host/db?sslmode=require) — DB_URL prend
# le pas sur les champs séparés s'il est renseigné.
DB_CONNECTION=
DB_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# 'require' par défaut dans le code (Neon impose TLS). À ne surcharger que
# si votre Postgres local n'a pas SSL configuré (ex: DB_SSLMODE=prefer).
DB_SSLMODE=

SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=
# false en local (http), true en production (https)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=
FILESYSTEM_DISK=
QUEUE_CONNECTION=

CACHE_STORE=
# CACHE_PREFIX=

MEMCACHED_HOST=

REDIS_CLIENT=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# --- Email (Resend) ---
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# Clé API : https://resend.com/api-keys — mettre MAIL_MAILER=resend pour l'utiliser
RESEND_KEY=
# Doit être une adresse sur un domaine vérifié dans Resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

VITE_APP_NAME=

# --- Frontend / CORS / Sanctum ---
# URL du frontend (SPA Next.js). Local : http://localhost:3000
# Production : l'URL réelle du frontend, définie dans Render.
FRONTEND_URL=

# Domaines autorisés à recevoir le cookie de session Sanctum, séparés par
# des virgules. Local : localhost,localhost:3000,localhost:8000,127.0.0.1,...
# Production : les domaines réels (frontend + API), définis dans Render.
SANCTUM_STATEFUL_DOMAINS=

# Optionnel : origines CORS supplémentaires séparées par des virgules
# (ex: variante "www."), en plus de FRONTEND_URL.
ADDITIONAL_CORS_ORIGINS=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# ⚠️ GOOGLE_REDIRECT_URL doit pointer vers le FRONTEND (qui relaie le code à
# POST /api/auth/google/exchange), jamais vers ce backend directement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# --- Meta / Facebook Login (https://developers.facebook.com/apps) ---
# Même remarque : doit pointer vers le FRONTEND.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# --- UserDataSeeder (dev uniquement — jamais exécuté en production, aucun
# script de déploiement n'appelle db:seed). Si absent, un mot de passe
# aléatoire est généré à chaque exécution du seeder. ---
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
