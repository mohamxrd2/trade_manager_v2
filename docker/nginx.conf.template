# ---------------------------------------------------------------------------
# CORS des erreurs générées par Nginx (413, 502, 504…) : sans ces en-têtes,
# le navigateur masque la vraie erreur et le front affichait « Erreur CORS ».
# Les réponses de Laravel portent déjà leurs propres en-têtes : Nginx n'en
# ajoute QUE si la réponse n'en a pas (sinon l'en-tête serait en double et
# le navigateur refuserait la réponse).
# /etc/nginx/cors-origins.map est généré au démarrage depuis la config
# Laravel (php artisan cors:nginx-map, voir docker/entrypoint.sh).
# ---------------------------------------------------------------------------
map $http_origin $cors_allowed_origin {
    default "";
    include /etc/nginx/cors-origins.map;
}

map $upstream_http_access_control_allow_origin $cors_fallback_origin {
    ""      $cors_allowed_origin;
    default "";
}

map $cors_fallback_origin $cors_fallback_credentials {
    ""      "";
    default "true";
}

map $cors_fallback_origin $cors_fallback_vary {
    ""      "";
    default "Origin";
}

# Identifiant de requête : celui du front (X-Request-Id) s'il est valide,
# sinon celui de Nginx. Transmis à Laravel, écrit dans le journal d'accès,
# renvoyé au navigateur (par Laravel, ou par Nginx sur ses propres erreurs).
map $http_x_request_id $req_id {
    "~^[A-Za-z0-9-]{8,64}$" $http_x_request_id;
    default                 $request_id;
}

map $upstream_http_x_request_id $request_id_fallback {
    ""      $req_id;
    default "";
}

log_format waelly '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                  'rt=$request_time up=$upstream_status rid=$req_id origin="$http_origin"';

server {
    # ${PORT} est substitué au démarrage du conteneur (envsubst, voir
    # docker/entrypoint.sh) — Render fournit ce port dynamiquement au
    # runtime, jamais au moment du build de l'image.
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /app/public;
    index index.php;

    # Envoi d'images : 5 Mo côté Laravel (config/media.php) + l'enveloppe
    # multipart. Doit rester >= post_max_size de docker/php.ini (8M).
    client_max_body_size 8m;

    add_header Access-Control-Allow-Origin $cors_fallback_origin always;
    add_header Access-Control-Allow-Credentials $cors_fallback_credentials always;
    add_header Vary $cors_fallback_vary always;
    add_header X-Request-Id $request_id_fallback always;

    access_log /dev/stdout waelly;
    error_log /dev/stderr;

    # gzip est déjà activé par défaut (nginx.conf du paquet Debian, non
    # modifié) mais gzip_types y est laissé commenté, donc seul text/html
    # est compressé par défaut. Cette app étant une API JSON quasi pure,
    # sans cette ligne aucune réponse n'était réellement compressée.
    gzip_types application/json application/javascript text/css text/plain;
    gzip_min_length 512;

    # Routage standard Laravel : toute URL sans fichier correspondant passe
    # par index.php (front controller), qui gère le routing applicatif.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # Mitigation httpoxy (CVE-2016-5385) : empêche un header HTTP
        # "Proxy" arbitraire envoyé par le client d'écraser la variable
        # d'environnement HTTP_PROXY vue par PHP.
        fastcgi_param HTTP_PROXY "";
        # Même identifiant de requête dans Nginx et dans Laravel.
        fastcgi_param HTTP_X_REQUEST_ID $req_id;
        # PHP s'arrête à 55 s, PHP-FPM à 60 s : Nginx attend un peu plus,
        # pour que ce soit Laravel (ou FPM) qui réponde, pas un 504 muet.
        fastcgi_read_timeout 65s;
        fastcgi_send_timeout 65s;
    }

    # Bloque l'accès direct à tout fichier caché (.env, .git, etc.) s'il
    # se retrouvait un jour dans public/ — .env lui-même est déjà hors de
    # portée du document root Laravel, ceci est une protection additionnelle.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
